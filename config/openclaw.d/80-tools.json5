{
  "tools": {
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "agentToAgent": {
      // Enable cross-agent session tools (sessions_send / sessions_history / sessions_list / session_status).
      // Needed for main <-> kimi and main <-> writer collaboration via those tools.
      "enabled": true,
      "allow": ["main", "kimi", "writer"]
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "perplexity",
        "perplexity": {
          "apiKey": "${PERPLEXITY_API_KEY}",
          "baseUrl": "https://api.perplexity.ai/v2",
          "model": "sonar-pro"
        }
      },
      "fetch": {
        "enabled": true
      }
    },
    "media": {
      "audio": {
        "enabled": true,
        "scope": {
          // Restrict audio transcription to default/main and writer agent sessions.
          "default": "deny",
          "rules": [
            { "action": "allow", "match": { "keyPrefix": "agent:main:" } },
            { "action": "allow", "match": { "keyPrefix": "agent:writer:" } }
          ]
        },
        "models": [
          {
            "type": "cli",
            "command": "/home/dev/ai/moonshine-asr/.venv/bin/python",
            "args": [
              "/home/dev/agents/openclaw-platform/scripts/moonshine_transcribe.py",
              "--audio",
              "{{MediaPath}}",
              "--model-path",
              "/home/dev/ai/moonshine-asr/models/download.moonshine.ai/model/small-streaming-en/quantized",
              "--model-arch",
              "4"
            ],
            "timeoutSeconds": 90
          }
        ]
      }
    }
  }
}
