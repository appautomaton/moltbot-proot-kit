{
  "id": "writer",
  "workspace": "${OPENCLAW_STATE_DIR}/workspaces/writer",
  "sandbox": {
    "mode": "all",
    "workspaceAccess": "rw",
    "scope": "agent",
    "workspaceRoot": "${OPENCLAW_STATE_DIR}/workspaces/writer",
    "docker": {
      "image": "localhost/openclaw-sandbox-writer:bookworm",
      "readOnlyRoot": true,
      "network": "bridge",
      "env": {
        "HOME": "/workspace/.home",
        "XDG_CACHE_HOME": "/workspace/.cache",
        "XDG_CONFIG_HOME": "/workspace/.config",
        "XDG_DATA_HOME": "/workspace/.local/share",
        "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
      },
      "setupCommand": "mkdir -p /workspace/.home /workspace/.cache /workspace/.config /workspace/.local/share"
    }
  },
  "tools": {
    "profile": "full",
    "allow": [
      "group:fs",
      "group:runtime",
      "group:sessions",
      "memory_search",
      "memory_get",
      "group:web"
    ],
    "deny": [
      "browser",
      "canvas",
      "gateway",
      "nodes",
      "cron"
    ],
    "exec": {
      "host": "sandbox",
      "security": "full",
      "ask": "off"
    },
    "sandbox": {
      "tools": {
        "allow": [
          "group:fs",
          "group:runtime",
          "group:sessions",
          "memory_search",
          "memory_get",
          "group:web"
        ]
      }
    }
  }
}
