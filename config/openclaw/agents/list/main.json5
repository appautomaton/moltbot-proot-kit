{
  "id": "main",
  "default": true,
  "groupChat": {
    "mentionPatterns": [
      "\\b@?ac_m1p_default_bot\\b"
    ]
  },
  "subagents": {
    "allowAgents": [
      "gemini",
      "coder-cli"
    ]
  },
  "tools": {
    "profile": "full",
    "allow": [
      "group:web",
      "exa-search",
      "group:fs",
      "group:runtime",
      "group:sessions",
      "group:memory",
      "browser",
      "canvas"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "deny": [
      "gateway",
      "nodes",
      "cron"
    ]
  }
}
