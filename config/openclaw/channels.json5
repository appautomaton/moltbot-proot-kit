{
  "telegram": {
    "enabled": true,
    "configWrites": false,
    "dmPolicy": "pairing",
    "groups": {
      "*": {
        "requireMention": true
      }
    },
    "groupAllowFrom": [
      "${TELEGRAM_OWNER_ID}"
    ],
    "groupPolicy": "allowlist",
    "streaming": {
      "mode": "partial"
    },
    "actions": {
      "sendMessage": true
    },
    "accounts": {
      "default": {
        "name": "ac-m1-default",
        "dmPolicy": "pairing",
        "botToken": "${TELEGRAM_BOT_TOKEN_DEFAULT}",
        "groupPolicy": "allowlist",
        "streaming": {
          "mode": "partial"
        }
      },
      "coder-cli": {
        "name": "coder-cli",
        "enabled": true,
        "dmPolicy": "pairing",
        "botToken": "${TELEGRAM_BOT_TOKEN_CODER_CLI}",
        "groupPolicy": "allowlist",
        "streaming": {
          "mode": "partial"
        }
      },
      "writer": {
        "name": "writer",
        "enabled": true,
        "dmPolicy": "pairing",
        "botToken": "${TELEGRAM_BOT_TOKEN_WRITER}",
        "groupPolicy": "allowlist",
        "streaming": {
          "mode": "partial"
        }
      }
    }
  }
}
