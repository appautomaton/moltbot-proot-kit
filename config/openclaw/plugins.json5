{
  "enabled": true,
  "load": {
    "paths": [
      "${OPENCLAW_STATE_DIR}/../plugins"
    ]
  },
  "allow": [
    "telegram",
    "memory-core",
    "google-gemini-cli-auth",
    "exa-search"
  ],
  "entries": {
    "exa-search": {
      "enabled": true,
      "config": {
        "apiKeyEnv": "EXA_API_KEY"
      }
    },
    "google-gemini-cli-auth": {
      "enabled": true
    },
    "memory-core": {
      "enabled": true
    },
    "telegram": {
      "enabled": true
    }
  }
}
