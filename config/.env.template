# =============================================================================
# OpenClaw Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# IMPORTANT: Never commit .env to version control!
#
# Usage:
#   cp config/.env.template config/.env
#   # Edit config/.env with your values
#   pnpm openclaw gateway
# =============================================================================


# =============================================================================
# PATHS & DIRECTORIES
# =============================================================================

# OpenClaw state directory (config, sessions, credentials, etc.)
# Recommended for this repo: bots
OPENCLAW_STATE_DIR=bots

# Wrapper source config root.
# The wrapper renders this modular tree into $OPENCLAW_STATE_DIR/.runtime/openclaw.runtime.json5 before launch.
OPENCLAW_CONFIG_PATH=config/openclaw/openclaw.json5

# Browser executable path (Chromium/Chrome)
# Examples:
#   macOS: "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
#   Linux: /home/dev/.cache/ms-playwright/chromium-1208/chrome-linux/chrome
BROWSER_EXECUTABLE_PATH=


# =============================================================================
# MODEL PROVIDERS
# =============================================================================

# NVIDIA Integrate API (for Kimi K2.5 model)
# Get your key at: https://build.nvidia.com/
NVIDIA_INTEGRATE_API_KEY=

# Gemini API (for memory search embeddings)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_MEMORY_API_KEY=


# =============================================================================
# TOOLS & SERVICES
# =============================================================================

# Perplexity API (for web search)
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# xAI API (for Grok web search)
# Get your key at: https://console.x.ai/
XAI_API_KEY=

# Exa API (for exa-search plugin)
# Get your key at: https://exa.ai/
EXA_API_KEY=


# =============================================================================
# CHANNELS
# =============================================================================

# Telegram Bot Tokens
# Create bots via @BotFather on Telegram
TELEGRAM_BOT_TOKEN_DEFAULT=
TELEGRAM_BOT_TOKEN_CODER_CLI=
TELEGRAM_BOT_TOKEN_WRITER=

# Telegram user id allowed to DM/control the bot(s)
TELEGRAM_OWNER_ID=

# codex-agent hook integration for the default workspace skill
# Optional: agent wakeups still work without CODEX_AGENT_CHAT_ID, but channel notifications do not.
CODEX_AGENT_CHAT_ID=
CODEX_AGENT_CHANNEL=telegram
CODEX_AGENT_NAME=main


# =============================================================================
# GATEWAY
# =============================================================================

# Bonjour/mDNS hostname for LAN discovery (avoid conflicts like "openclaw-(2)")
OPENCLAW_MDNS_HOSTNAME=

# Gateway Authentication Token
# Generate a secure random token: openssl rand -hex 32
GATEWAY_AUTH_TOKEN=


# =============================================================================
# GOG (Google OAuth CLI)
# =============================================================================
# Leave blank if you don't use Google Calendar/Gmail integration.

# Config home directory for gogcli (where gog stores credentials/tokens)
XDG_CONFIG_HOME=

# Keyring password for decrypting GOG OAuth tokens
# Get this from: cat ~/.openclaw/.secrets/gog/keyring.pass
GOG_KEYRING_PASSWORD=

# Gemini CLI OAuth for OpenClaw model access is configured via local auth state:
#   pnpm openclaw models auth login --provider google-gemini-cli --set-default


# =============================================================================
# MOLTBOOK
# =============================================================================

# Moltbook API key (used by some sandbox/agent configs)
MOLTBOOK_API_KEY=
